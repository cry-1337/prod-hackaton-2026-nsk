{
  "uid": "vmeste-overview",
  "title": "Вместе — API и сборы",
  "editable": false,
  "schemaVersion": 39,
  "version": 4,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Доступность API",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"vmeste-api\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступен",
                  "color": "red"
                },
                "1": {
                  "text": "Доступен",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Запросы в секунду",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_requests_received_total{job=\"vmeste-api\"}[$__rate_interval])) or (max(up{job=\"vmeste-api\"}) == 1) * 0) and (max(up{job=\"vmeste-api\"}) == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Время ответа p95",
      "description": "95% запросов укладываются в это время. Значение появляется, когда в выбранном интервале есть запросы.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"vmeste-api\"}[$__rate_interval]))) and (max(up{job=\"vmeste-api\"}) == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Доля ответов 5xx",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_requests_received_total{job=\"vmeste-api\",code=\"5xx\"}[$__rate_interval])) or (max(up{job=\"vmeste-api\"}) == 1) * 0) / clamp_min((sum(rate(http_requests_received_total{job=\"vmeste-api\"}[$__rate_interval])) or (max(up{job=\"vmeste-api\"}) == 1) * 0), 1e-9)) and (max(up{job=\"vmeste-api\"}) == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Запросы по HTTP-статусу",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(http_requests_received_total{job=\"vmeste-api\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Время ответа API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"vmeste-api\"}[$__rate_interval])))",
          "legendFormat": "Медиана",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"vmeste-api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Сборы по статусу",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_groups{job=\"vmeste-api\",status=\"open\"} and on (job, instance) ((time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60) and on (job, instance) (up{job=\"vmeste-api\"} == 1)))",
          "legendFormat": "Открыты",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(vmeste_groups{job=\"vmeste-api\",status=\"successful\"} and on (job, instance) ((time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60) and on (job, instance) (up{job=\"vmeste-api\"} == 1)))",
          "legendFormat": "Успешны",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(vmeste_groups{job=\"vmeste-api\",status=\"cancelled\"} and on (job, instance) ((time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60) and on (job, instance) (up{job=\"vmeste-api\"} == 1)))",
          "legendFormat": "Отменены",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Просроченные сборы",
      "description": "Сборы, у которых прошёл дедлайн и в базе всё ещё стоит статус «Открыт».",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_groups_overdue{job=\"vmeste-api\"} and on (job, instance) ((time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60) and on (job, instance) (up{job=\"vmeste-api\"} == 1)))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "title": "Сбои за 15 минут",
      "description": "Ошибки фонового закрытия просроченных сборов за последние 15 минут.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vmeste_expiration_failures_total{job=\"vmeste-api\"}[15m])) and (max(up{job=\"vmeste-api\"}) == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "title": "Память процесса API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_working_set_bytes{job=\"vmeste-api\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Время с последней успешной проверки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - vmeste_expiration_last_success_timestamp_seconds{job=\"vmeste-api\"}",
          "legendFormat": "Закрытие сборов",
          "range": true
        },
        {
          "refId": "B",
          "expr": "time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"}",
          "legendFormat": "Обновление статистики",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Заявки «Куплю до»",
      "description": "Текущее состояние последней заявки каждого покупателя в каждом сборе.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"pending\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Ожидает",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"purchased\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Покупка",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"revoked\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Отозвана",
          "range": true
        },
        {
          "refId": "D",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"refunded\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Возвращена",
          "range": true
        },
        {
          "refId": "E",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"unmatched\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Цена выше максимума",
          "range": true
        },
        {
          "refId": "F",
          "expr": "max(vmeste_limit_applications{job=\"vmeste-api\",outcome=\"closed\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Закрыта без оплаты",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Время от создания сбора до достижения порога",
      "description": "По всем успешно завершённым сборам с известным временем достижения порога.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_group_time_to_success_seconds{job=\"vmeste-api\",quantile=\"0.5\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Медиана",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(vmeste_group_time_to_success_seconds{job=\"vmeste-api\",quantile=\"0.95\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "Количество возвратов по причинам",
      "description": "Причины возвратов по предоплатам учитываются с момента релиза. Для прямых оплат также учтены сохранённые ранее возвраты.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"price_drop\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Снижение цены",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"group_cancelled\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Отмена сбора",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"limit_revoked\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Отзыв заявки",
          "range": true
        },
        {
          "refId": "D",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"limit_changed\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Изменение заявки",
          "range": true
        },
        {
          "refId": "E",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"direct_checkout\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Переход к прямой оплате",
          "range": true
        },
        {
          "refId": "F",
          "expr": "max(vmeste_refunds{job=\"vmeste-api\",reason=\"unmatched\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Цена выше максимума",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "title": "Сумма возвратов по причинам",
      "description": "Причины возвратов по предоплатам учитываются с момента релиза. Для прямых оплат также учтены сохранённые ранее возвраты.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vmeste_refunds_rubles{job=\"vmeste-api\",reason=\"price_drop\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Снижение цены",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(vmeste_refunds_rubles{job=\"vmeste-api\",reason=\"group_cancelled\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Отмена сбора",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(vmeste_refunds_rubles{job=\"vmeste-api\",reason=\"limit_revoked\"} and on(job, instance) (time() - vmeste_group_snapshot_last_success_timestamp_seconds{job=\"vmeste-api\"} < 60))",
          "legendFormat": "Отзыв заявки",
          "range": true
        },
