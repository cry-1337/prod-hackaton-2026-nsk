{
  "uid": "vmeste-red-use",
  "title": "Вместе — RED и USE",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Частота запросов по контроллеру",
      "description": "Запросы к HTTP API по контроллеру и методу за интервал расчёта.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller, method) (rate(http_requests_received_total{job=\"vmeste-api\",controller!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{method}} · {{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Доля ответов 5xx по контроллеру",
      "description": "Доля серверных ошибок среди завершённых запросов. Серии показаны для контроллеров, у которых был трафик.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (controller) (rate(http_requests_received_total{job=\"vmeste-api\",controller!=\"\",code=\"5xx\"}[$__rate_interval])) or (0 * sum by (controller) (rate(http_requests_received_total{job=\"vmeste-api\",controller!=\"\"}[$__rate_interval])))) / (sum by (controller) (rate(http_requests_received_total{job=\"vmeste-api\",controller!=\"\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Время ответа p95 по контроллеру",
      "description": "Время, в которое укладываются 95% завершённых запросов к контроллеру.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (controller, le) (rate(http_request_duration_seconds_bucket{job=\"vmeste-api\",controller!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Занятые подключения PostgreSQL",
      "description": "Отношение видимых клиентских соединений к max_connections всего экземпляра PostgreSQL.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(vmeste_postgres_client_connections{job=\"vmeste-api\"} / vmeste_postgres_connection_limit{job=\"vmeste-api\"}) and on(job,instance) (vmeste_postgres_stats_up{job=\"vmeste-api\"} == 1) and on(job,instance) (up{job=\"vmeste-api\"} == 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Ожидание блокировок PostgreSQL",
      "description": "Сеансы базы приложения, ожидающие выдачи блокировки в момент опроса. Короткие ожидания между опросами могут быть пропущены.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmeste_postgres_lock_waiting_sessions{job=\"vmeste-api\"} and on(job,instance) (vmeste_postgres_stats_up{job=\"vmeste-api\"} == 1) and on(job,instance) (up{job=\"vmeste-api\"} == 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Взаимоблокировки PostgreSQL",
      "description": "Сколько взаимоблокировок PostgreSQL обнаружил в базе приложения с последнего сброса статистики PostgreSQL.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmeste_postgres_deadlocks_since_reset{job=\"vmeste-api\"} and on(job,instance) (vmeste_postgres_stats_up{job=\"vmeste-api\"} == 1) and on(job,instance) (up{job=\"vmeste-api\"} == 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Сбор статистики PostgreSQL",
      "description": "1 — последнее чтение статистики БД успешно, 0 — завершилось ошибкой или ещё не выполнено.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vmeste-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmeste_postgres_stats_up{job=\"vmeste-api\"} and on(job,instance) (up{job=\"vmeste-api\"} == 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
